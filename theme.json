{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#FFF8EA",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#FFFDF8",
          "name": "Surface",
          "slug": "surface"
        },
        {
          "color": "#4A3F35",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#6F5F51",
          "name": "Contrast - Dark",
          "slug": "contrast-dark"
        },
        {
          "color": "#D9CDBE",
          "name": "Contrast - Medium",
          "slug": "contrast-medium"
        },
        {
          "color": "#F3EBDD",
          "name": "Contrast - Light",
          "slug": "contrast-light"
        },
        {
          "color": "#9FDFBF",
          "name": "Leaf",
          "slug": "primary"
        },
        {
          "color": "#A9DCF7",
          "name": "Sky",
          "slug": "secondary"
        },
        {
          "color": "#FFC3AE",
          "name": "Peach",
          "slug": "tertiary"
        },
        {
          "color": "#FFE58A",
          "name": "Butter",
          "slug": "butter"
        },
        {
          "color": "#D6C8F5",
          "name": "Lavender",
          "slug": "lavender"
        },
        {
          "color": "#FFC9DD",
          "name": "Pink",
          "slug": "pink"
        },
        {
          "color": "#24604A",
          "name": "Link",
          "slug": "link"
        }
      ]
    },
    "custom": {
      "button": {
        "outline": {
          "borderWidth": "2px"
        }
      },
      "lineHeight": {
        "large": "2.2",
        "medium": "1.8",
        "small": "1.5",
        "x-large": "2.6"
      },
      "navigation": {
        "submenu": {
          "max-width": "22rem",
          "offset": "0.6rem",
          "radius": "0.5rem",
          "shadow": "0 14px 32px -10px rgb(0 0 0 / 0.18), 0 2px 6px rgb(0 0 0 / 0.08)"
        }
      },
      "outline": {
        "width": "2px",
        "offset": "2px",
        "style": "solid"
      },
      "card": {
        "radius": "1.75rem",
        "tilt": "0.9deg",
        "badgeOffset": "1.05rem",
        "padding": "1.9rem 1.85rem 1.6rem"
      },
      "pill": {
        "radius": "999px",
        "lip": "3px"
      },
      "band": {
        "waveHeight": "2.75rem"
      },
      "quote": {
        "fill": "color-mix(in oklab, var(--wp--preset--color--lavender) 35%, var(--wp--preset--color--surface))",
        "mark": "color-mix(in oklab, var(--wp--preset--color--lavender) 40%, var(--wp--preset--color--contrast))"
      }
    },
    "layout": {
      "contentSize": "640px",
      "wideSize": "1080px"
    },
    "border": {
      "radius": true,
      "radiusSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "0.125rem"
        },
        {
          "name": "Small",
          "slug": "sm",
          "size": "0.25rem"
        },
        {
          "name": "Medium",
          "slug": "md",
          "size": "0.375rem"
        },
        {
          "name": "Large",
          "slug": "lg",
          "size": "0.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "0.75rem"
        },
        {
          "name": "2XL",
          "slug": "2-xl",
          "size": "1rem"
        },
        {
          "name": "3XL",
          "slug": "3-xl",
          "size": "1.5rem"
        }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "X-Small",
          "size": "0.5rem",
          "slug": "xs"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "s"
        },
        {
          "name": "Medium",
          "size": "1.5rem",
          "slug": "m"
        },
        {
          "name": "Large",
          "size": "clamp(2rem, 3vw, 3rem)",
          "slug": "l"
        },
        {
          "name": "X-Large",
          "size": "clamp(3rem, 5vw, 5rem)",
          "slug": "xl"
        },
        {
          "name": "2X-Large",
          "size": "clamp(5rem, 8vw, 8rem)",
          "slug": "xxl"
        },
        {
          "name": "3X-Large",
          "size": "clamp(8rem, 12vw, 12rem)",
          "slug": "xxxl"
        }
      ],
      "units": ["rem", "em", "%", "vw", "vh", "px"]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": true,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Nunito",
          "slug": "body",
          "fontFamily": "\"Nunito\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Nunito",
              "fontStyle": "normal",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
              "src": ["file:./assets/fonts/nunito-latin-wght-normal.woff2"]
            },
            {
              "fontFamily": "Nunito",
              "fontStyle": "italic",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
              "src": ["file:./assets/fonts/nunito-latin-wght-italic.woff2"]
            },
            {
              "fontFamily": "Nunito",
              "fontStyle": "normal",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF",
              "src": ["file:./assets/fonts/nunito-latin-ext-wght-normal.woff2"]
            },
            {
              "fontFamily": "Nunito",
              "fontStyle": "italic",
              "fontWeight": "200 1000",
              "fontDisplay": "swap",
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF",
              "src": ["file:./assets/fonts/nunito-latin-ext-wght-italic.woff2"]
            }
          ]
        },
        {
          "name": "Fredoka",
          "slug": "heading",
          "fontFamily": "\"Fredoka\", \"Nunito\", system-ui, -apple-system, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Fredoka",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
              "src": ["file:./assets/fonts/fredoka-latin-wght-normal.woff2"]
            },
            {
              "fontFamily": "Fredoka",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF",
              "src": ["file:./assets/fonts/fredoka-latin-ext-wght-normal.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
