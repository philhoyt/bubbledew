          "slug": "xxs"
        },
        {
          "fluid": false,
          "name": "X-Small",
          "size": "0.875rem",
          "slug": "xs"
        },
        {
          "fluid": false,
          "name": "Small",
          "size": "1rem",
          "slug": "s"
        },
        {
          "fluid": false,
          "name": "Medium",
          "size": "1.125rem",
          "slug": "m"
        },
        {
          "fluid": {
            "max": "1.5rem",
            "min": "1.25rem"
          },
          "name": "Large",
          "size": "1.5rem",
          "slug": "l"
        },
        {
          "fluid": {
            "max": "2rem",
            "min": "1.5rem"
          },
          "name": "X-Large",
          "size": "2rem",
          "slug": "xl"
        },
        {
          "fluid": {
            "max": "2.25rem",
            "min": "1.75rem"
          },
          "name": "2X-Large",
          "size": "2.25rem",
          "slug": "xxl"
        },
        {
          "fluid": {
            "max": "3.75rem",
            "min": "2rem"
          },
          "name": "3X-Large",
          "size": "3.75rem",
          "slug": "xxxl"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "useRootPaddingAwareAlignments": true,
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Card",
          "slug": "card",
          "shadow": "0 14px 28px -16px rgb(120 80 50 / 0.35), 0 2px 6px rgb(120 80 50 / 0.06)"
        },
        {
          "name": "Lift",
          "slug": "lift",
          "shadow": "0 22px 36px -16px rgb(120 80 50 / 0.42), 0 2px 6px rgb(120 80 50 / 0.06)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "blocks": {
      "core/columns": {
        "spacing": {
          "blockGap": "var:preset|spacing|l"
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "spacing": {
              "padding": {
                "top": "calc(var(--wp--preset--spacing--xs) - var(--wp--custom--button--outline--border-width))",
                "bottom": "calc(var(--wp--preset--spacing--xs) - var(--wp--custom--button--outline--border-width))"
              }
            }
          }
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var:preset|spacing|s"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--m)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "core/navigation-link": {
        "css": ".current-menu-item > a, .current-page-ancestor > a { text-decoration: underline; }"
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--m)"
        }
      },
      "core/quote": {
        "border": {
          "radius": "var(--wp--custom--card--radius)"
        },
        "color": {
          "background": "var(--wp--custom--quote--fill)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--l)",
            "right": "var(--wp--preset--spacing--m)",
            "bottom": "var(--wp--preset--spacing--m)",
            "left": "var(--wp--preset--spacing--m)"
          }
        },
        "elements": {
          "cite": {
            "color": {
              "text": "var(--wp--preset--color--contrast-dark)"
            },
            "typography": {
              "fontSize": "var(--wp--preset--font-size--xs)",
              "fontStyle": "normal",
              "fontWeight": "700"
            }
          }
        }
      },
      "core/separator": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 1px 0"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast-medium)"
        }
      },
      "core/avatar": {
        "border": {
          "radius": "45% 55% 50% 50% / 55% 45% 55% 45%"
        }
      },
      "core/comment-author-name": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-content": {
        "css": "& > * { margin-block: 0.75rem 0; } & > :first-child { margin-block-start: 0; }"
      },
      "core/comment-date": {
        "color": {
          "text": "var(--wp--preset--color--contrast-dark)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-edit-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-reply-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-template": {
        "css": "& li { margin-block-end: 0; }"
      },
      "core/comments-pagination": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        }
      },
      "core/comments-pagination-numbers": {
        "css": "& .page-numbers { padding: 0 0.25rem; } & .page-numbers.current { text-decoration: underline; text-underline-offset: 0.3em; }"
      },
      "core/comments-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/latest-comments": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)"
        },
        "css": "& .wp-block-latest-comments__comment { margin-block-end: var(--wp--preset--spacing--s); } & .wp-block-latest-comments__comment-date { font-size: inherit; } & .wp-block-latest-comments__comment-excerpt p { font-size: inherit; margin: 0.25rem 0 0; }"
      },
      "core/post-comments-form": {
        "css": "& .comment-form > * { margin-block: var(--wp--preset--spacing--s) 0; } & .comment-form-cookies-consent { display: flex; align-items: baseline; gap: 0.5em; } & .comment-form-cookies-consent label { font-weight: 400; letter-spacing: normal; text-transform: none; } & label { font-size: var(--wp--preset--font-size--xs); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; } & .comment-reply-title { font-size: var(--wp--preset--font-size--l); } & .comment-reply-title small { font-size: var(--wp--preset--font-size--xs); margin-inline-start: 0.5em; }"
      },
      "core/post-comments-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              }
            },
            ":focus": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              }
            }
          }
        }
      },
      "core/post-date": {
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-author-name": {
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            ":focus": {
              "color": {
                "text": "var(--wp--preset--color--link)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--xs)",
            "right": "var(--wp--preset--spacing--m)",
            "bottom": "var(--wp--preset--spacing--xs)",
            "left": "var(--wp--preset--spacing--m)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--m)",
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--secondary)",
            "text": "var(--wp--preset--color--contrast)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--secondary)",
            "text": "var(--wp--preset--color--contrast)"
          },
          "outline": {
            "color": "var(--wp--preset--color--contrast)",
            "offset": "var(--wp--custom--outline--offset)"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)",
          "lineHeight": "1.4"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxl)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)"
        }
      },
