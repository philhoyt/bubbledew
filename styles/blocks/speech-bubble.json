{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Speech bubble",
  "slug": "speech-bubble",
  "blockTypes": ["core/group", "core/site-tagline", "core/paragraph", "core/comment-content"],
  "styles": {
    "border": {
      "radius": "var(--wp--custom--card--radius)"
    },
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "shadow": "var(--wp--preset--shadow--card)",
    "spacing": {
      "padding": {
        "top": "var(--wp--preset--spacing--m)",
        "right": "var(--wp--preset--spacing--m)",
        "bottom": "var(--wp--preset--spacing--m)",
        "left": "var(--wp--preset--spacing--m)"
      }
    }
  }
}
